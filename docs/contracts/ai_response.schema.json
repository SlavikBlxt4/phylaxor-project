{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://phylaxor.dev/schemas/ai_response.schema.json",
    "title": "AIResponse",
    "description": "Schema for the structured response received from the AI Agent.",
    "type": "object",
    "required": [
        "schemaVersion",
        "requestId",
        "provider",
        "model",
        "summary",
        "triage",
        "hypotheses",
        "recommendedActions",
        "checks",
        "fixes"
    ],
    "properties": {
        "schemaVersion": {
            "type": "string"
        },
        "requestId": {
            "type": "string",
            "format": "uuid"
        },
        "provider": {
            "type": "string"
        },
        "model": {
            "type": "string"
        },
        "summary": {
            "type": "string",
            "maxLength": 500
        },
        "triage": {
            "type": "object",
            "required": [
                "severity",
                "confidence",
                "category"
            ],
            "properties": {
                "severity": {
                    "type": "string",
                    "enum": [
                        "critical",
                        "warning",
                        "info",
                        "unknown"
                    ]
                },
                "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "category": {
                    "type": "string"
                }
            }
        },
        "hypotheses": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "title",
                    "confidence",
                    "evidence",
                    "impact"
                ],
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                    },
                    "evidence": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "impact": {
                        "type": "string"
                    }
                }
            }
        },
        "recommendedActions": {
            "type": "array",
            "items": {
                "type": [
                    "string",
                    "object"
                ]
            }
        },
        "checks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "title",
                    "commands",
                    "reason"
                ],
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "commands": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "reason": {
                        "type": "string"
                    }
                }
            }
        },
        "fixes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "title",
                    "steps",
                    "risk",
                    "requiresWrite"
                ],
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "steps": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "risk": {
                        "type": "string",
                        "enum": [
                            "low",
                            "medium",
                            "high"
                        ]
                    },
                    "requiresWrite": {
                        "type": "boolean"
                    }
                }
            }
        },
        "missingInfo": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "safety": {
            "type": "object",
            "properties": {
                "notes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "suggestedToolCalls": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "tool",
                    "args",
                    "reason"
                ],
                "properties": {
                    "tool": {
                        "type": "string"
                    },
                    "args": {
                        "type": "object"
                    },
                    "reason": {
                        "type": "string"
                    }
                }
            }
        },
        "usage": {
            "type": "object",
            "properties": {
                "inputTokens": {
                    "type": "integer"
                },
                "outputTokens": {
                    "type": "integer"
                },
                "estimatedCostUsd": {
                    "type": "number"
                },
                "latencyMs": {
                    "type": "integer"
                }
            }
        }
    }
}